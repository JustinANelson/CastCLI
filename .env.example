# Copy to .env and fill in the keys for whichever cloud providers your config references
# (apiKeyEnv in config/harness.local.json). CastCLI reads .env automatically as a fallback --
# real environment variables always take priority over this file. Never commit .env itself
# (it's gitignored); this file only documents the variable names.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
