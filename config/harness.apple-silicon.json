{
  "providers": [
    {
      "id": "coder-local-mac-small",
      "tier": "SMALL_LOCAL",
      "baseUrl": "${OLLAMA_BASE_URL:http://localhost:11434/v1/}",
      "modelName": "qwen2.5-coder:3b",
      "apiKeyEnv": null,
      "temperature": 0.1,
      "timeoutSeconds": 120,
      "toolsEnabled": true,
      "maxToolsSupported": 6,
      "enabled": true
    },
    {
      "id": "labor-local-mac-large",
      "tier": "LARGE_LOCAL",
      "baseUrl": "${OLLAMA_BASE_URL:http://localhost:11434/v1/}",
      "modelName": "qwen2.5-coder:32b",
      "apiKeyEnv": null,
      "temperature": 0.1,
      "timeoutSeconds": 300,
      "toolsEnabled": true,
      "maxToolsSupported": 10,
      "enabled": true
    },
    {
      "id": "pm-frontier-anthropic",
      "tier": "FRONTIER_CLOUD",
      "baseUrl": "https://api.anthropic.com/v1/",
      "modelName": "claude-3-7-sonnet-20250219",
      "apiKeyEnv": "ANTHROPIC_API_KEY",
      "temperature": 0.2,
      "timeoutSeconds": 300,
      "toolsEnabled": true,
      "maxToolsSupported": 10,
      "enabled": true
    }
  ],
  "routing": {
    "quickPromptMaxChars": 240,
    "preferLocal": true,
    "maxContextChars": 12000,
    "maxReworkIterations": 1
  },
  "tools": {
    "workspaceRoot": ".",
    "maxFileBytes": 262144,
    "jshellEnabled": false,
    "allowWrites": false,
    "allowShellExec": false,
    "requireApproval": true
  },
  "reliability": {
    "maxCostUsdPerTask": 1.0,
    "maxCumulativeCostUsd": 20.0,
    "maxRequestsPerMinute": 30
  },
  "embeddings": {
    "enabled": true,
    "baseUrl": "${OLLAMA_BASE_URL:http://localhost:11434/v1/}",
    "modelName": "qwen3-embedding:0.6b",
    "apiKeyEnv": null,
    "timeoutSeconds": 60,
    "chunkLines": 60,
    "chunkOverlapLines": 10,
    "maxFileBytes": 300000,
    "excludeGlobs": [
      "**/.git/**", "**/build/**", "**/.gradle/**", "**/.harness/**", "**/.cast/**", "**/node_modules/**",
      "**/dist/**", "**/target/**", "**/.idea/**", "**/.vs/**",
      "**/credentials.json", "**/credentials*.json", "**/*secret*", "**/*.pem", "**/*.key",
      "**/.env", "**/.env.*", "**/id_rsa*", "**/*.p12", "**/*.pfx"
    ],
    "indexPath": ".cast/index/workspace-embeddings.json",
    "costPerMillionInputTokens": 0.0
  }
}

